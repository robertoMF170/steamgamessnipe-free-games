# ─────────────────────────────────────────────────────────────
# SrRobs Free Games — configuração (.env). Copia para .env e preenche.
#   cp .env.example .env   (ou corre: npm run setup)
# ─────────────────────────────────────────────────────────────

# ── Discord ─────────────────────────────────────────────────
# discord.com/developers → Applications → Bot → Reset Token
DISCORD_TOKEN=
# discord.com/developers → Applications → General Information → Application ID
DISCORD_APP_ID=
# ID numérico do server (não o link discord.gg/...) — só usado para registrar comandos
GUILD_ID=
# Canal onde são publicadas as ofertas (opcional: se vazio, o bot escolhe um automaticamente)
DISCORD_LOG_CHANNEL_ID=

# ── Ciclo de ofertas ────────────────────────────────────────
# Minutos entre verificações da loja Steam (mín. 10)
OFERTA_INTERVAL_MIN=30
# Páginas de resultados a percorrer na pesquisa de specials (50 por página)
OFERTA_MAX_PAGINAS=4
# Anúncios expirados são limpos do histórico após X dias
OFERTA_LIMPAR_APOS_DIAS=30

# ── Cartas (arbitragem compra barato → vende cartas) ────────
# Preço máximo do jogo (€) para anunciar promos de cartas. 0 = desligado
CARTAS_PRECO_MAX_EUR=3
# Retorno estimado das cartas tem de ser ≥ preço do jogo + X%.
# 0 = as cartas têm de recuperar o custo (sem lucro garantido) · 100 = dobrar o dinheiro
CARTAS_LUCRO_MIN_PCT=0
# Máximo de jogos a analisar no mercado por ciclo (protege contra rate-limit)
CARTAS_POR_CICLO=15

# ── Infra ───────────────────────────────────────────────────
# Porta do healthcheck HTTP (só local)
HEALTH_PORT=3000
# Caminho da base de dados SQLite
DB_PATH=./data/srrobs.db
# Nível de log: debug | info | warn | error
LOG_LEVEL=info
# Timezone (formato IANA)
TZ=Europe/Lisbon

# ── Dono do bot (opcional) ──────────────────────────────────
OWNER_DISCORD_ID=
